{
  "name": "ogun-studio-web",
  "private": true,
  "version": "0.0.1-alpha",
  "description": "Ogun Studio frontend, shared by the Tauri shells (desktop, Android, iOS) and Studio-web.",
  "license": "Apache-2.0",
  "author": "Verne Ltd.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test src/api/identity.test.mjs src/lib/markdown.test.mjs src/lib/agentTools.test.mjs src/lib/duration.test.mjs tests/*.test.mjs",
    "build": "tsc --noEmit -p . && vite build",
    "build:demo": "tsc --noEmit -p . && vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --outDir dist-demo --port 4174",
    "build:site": "tsc --noEmit -p . && vite build --mode site --outDir dist-site",
    "build:desktop-demo": "tsc --noEmit -p . && vite build --mode desktop-demo --outDir dist-desktop-demo",
    "build:desktop-demo:app": "node scripts/build-desktop-demo.mjs",
    "check": "tsc --noEmit -p . && node scripts/sync-connectors.mjs && node ../../../connectors/tools/check.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
