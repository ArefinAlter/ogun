{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ogun Studio",
  "mainBinaryName": "ogun-studio",
  "version": "0.0.1-beta.1",
  "identifier": "dev.verne.ogun.studio",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../web",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../web"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Ogun Studio",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "studio",
        "gateway-android"
      ],
      "freezePrototype": true,
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173; base-uri 'none'; form-action 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "publisher": "Verne Ltd.",
    "copyright": "Copyright 2026 Verne Ltd. Apache-2.0.",
    "shortDescription": "Ogun Studio: data workflows with their own engine",
    "longDescription": "Ogun Studio runs its own Ogun engine on your computer: workflows, runs, partitions, approvals, artifacts, lineage, streams and agent threads, with nothing else to install or start.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "externalBin": [
      "binaries/ogund",
      "binaries/ogun",
      "binaries/ogun-op-llm",
      "binaries/ogun-op-shim",
      "binaries/ogun-ingest",
      "binaries/ogun-bench"
    ],
    "resources": {
      "../../../examples/starter": "samples/starter",
      "../../../examples/bikeshare": "samples/bikeshare"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Ogun"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "devel"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
