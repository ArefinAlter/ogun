{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "studio",
  "description": "Only the bundled main window may call the closed Ogun Studio command set and move, minimize, maximize and close itself. No shell, filesystem, HTTP, opener or remote-content permission is granted; the Rust process holds the daemon credential and the hub token.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-studio-info",
    "allow-link-local",
    "allow-link-hub",
    "allow-link-forget",
    "allow-prealpha-call",
    "allow-daemon-status",
    "allow-workflows-list",
    "allow-workflows-get",
    "allow-workflows-validate",
    "allow-workflows-put",
    "allow-runs-list",
    "allow-runs-get",
    "allow-runs-start",
    "allow-runs-cancel",
    "allow-partitions-status",
    "allow-backfills-plan",
    "allow-events-since",
    "allow-approvals-list",
    "allow-approvals-get",
    "allow-approvals-prepare",
    "allow-approvals-confirm",
    "allow-approvals-discard",
    "allow-artifacts-list",
    "allow-artifacts-get",
    "allow-lineage-get",
    "allow-streams-list",
    "allow-streams-status",
    "allow-edges-list",
    "allow-credentials-list",
    "allow-secrets-list",
    "allow-llm-ladder",
    "allow-engine-info",
    "allow-engine-restart",
    "allow-engine-call",
    "allow-secret-put",
    "allow-secret-delete",
    "allow-shell-prefs-get",
    "allow-shell-prefs-set",
    "allow-samples-list",
    "allow-sample-import",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-is-decorated",
    "core:window:allow-internal-toggle-maximize"
  ]
}
