{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Ogun Studio",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 520,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/ogund",
      "binaries/ogun",
      "binaries/ogun-op-llm",
      "binaries/ogun-op-shim",
      "binaries/ogun-ingest",
      "binaries/ogun-bench",
      "binaries/ogun-sandbox"
    ]
  }
}
