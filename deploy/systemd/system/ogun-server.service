# System unit for ogun-server, the HTTPS bridge of the server profile (O-13). It runs as the same `ogun` user as
# the daemon (the daemon refuses peers of another uid), reads the daemon's state read-only and writes only its own
# store in /var/lib/ogun/ogun-server.
#
# The OIDC client secret is handed over with LoadCredential=; point client_secret_file in /etc/ogun/server.json at
# /run/credentials/ogun-server.service/oidc-client-secret.

[Unit]
Description=Ogun server bridge (ogun-server)
Documentation=https://github.com/ArefinAlter/ogun/blob/main/docs/self-hosting.md
Wants=network-online.target ogund-server.service
After=network-online.target ogund-server.service

[Service]
Type=simple
User=ogun
Group=ogun
Environment=OGUN_HOME=/var/lib/ogun
Environment=OGUN_SERVER_HOME=/var/lib/ogun/ogun-server
Environment=OGUN_SERVER_CONFIG=/etc/ogun/server.json
Environment=OGUN_LOG=info
LoadCredential=oidc-client-secret:/etc/ogun/oidc-client-secret
ExecStartPre=/usr/local/bin/ogun-server check-config
ExecStart=/usr/local/bin/ogun-server serve
Restart=on-failure
RestartSec=2s

StateDirectory=ogun ogun/ogun-server
StateDirectoryMode=0700
UMask=0077
# The daemon's files are read-only to the bridge; connecting to its socket still works on a read-only mount.
ReadOnlyPaths=/var/lib/ogun
ReadWritePaths=/var/lib/ogun/ogun-server

CapabilityBoundingSet=
# To listen on 443 directly, uncomment both lines (they must stay after the empty assignment above).
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
