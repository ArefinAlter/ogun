{
  "ir_version": 0,
  "workflow": "acc-local-fixture",
  "version": 1,
  "description": "Acceptance: releases-like JSON from a local fixture server through parse, filter and partition into a manifest.",
  "budgets": { "bytes": 52428800, "wall_ms": 300000 },
  "nodes": [
    {
      "id": "fetch",
      "op": "acquire@1",
      "config": {
        "allowed_domains": ["fixture.localtest.me"],
        "sources": [{ "url": "http://fixture.localtest.me:38417/releases.json", "filename": "releases.json" }]
      },
      "policy": { "retries": 1 }
    },
    { "id": "rows", "op": "parse@1", "inputs": ["fetch.artifacts"], "config": {} },
    { "id": "published", "op": "filter@1", "inputs": ["rows.artifacts"], "config": { "where": { "eq": { "field": "draft", "value": false } } } },
    { "id": "by_kind", "op": "partition@1", "inputs": ["published.artifacts"], "config": { "by": "prerelease" } },
    { "id": "hash", "op": "hash@1", "inputs": ["by_kind.artifacts"] },
    { "id": "manifest", "op": "manifest@1", "inputs": ["hash.artifacts"] }
  ]
}
