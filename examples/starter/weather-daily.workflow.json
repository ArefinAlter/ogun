{
  "ir_version": 0,
  "workflow": "weather-daily",
  "version": 1,
  "description": "One day of weather history per partition from the Open-Meteo archive (a public API, no key), parsed into a row, hashed and listed in a manifest. Run it for a day, or backfill a range; a stop in the middle resumes only the days that did not finish. Needs the internet; no model access.",
  "partitions": { "kind": "time", "granularity": "day", "start": "2026-01-01" },
  "budgets": { "bytes": 52428800, "wall_ms": 3600000 },
  "nodes": [
    {
      "id": "fetch",
      "op": "acquire@1",
      "config": {
        "allowed_domains": ["archive-api.open-meteo.com"],
        "sources": [
          {
            "url": "https://archive-api.open-meteo.com/v1/archive?latitude=52.52&longitude=13.41&start_date={partition}&end_date={partition}&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&timezone=UTC",
            "filename": "weather-{partition}.json"
          }
        ],
        "fetch": { "min_interval_ms": 250 }
      },
      "policy": { "retries": 3, "concurrency": 2 }
    },
    { "id": "rows", "op": "parse@1", "inputs": ["fetch.artifacts"], "config": { "pointer": "/daily" } },
    { "id": "hash", "op": "hash@1", "inputs": ["rows.artifacts"] },
    { "id": "manifest", "op": "manifest@1", "inputs": ["hash.artifacts"] }
  ]
}
